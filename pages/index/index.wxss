.page { height: 100%; position: relative; overflow: hidden; }
.header { position: absolute; top: 36rpx; left: 40rpx; right: 40rpx; display: flex; justify-content: space-between; pointer-events: none; z-index: 1; }
.eyebrow { font-size: 18rpx; letter-spacing: 4rpx; color: #718d84; }
.title { font-size: 54rpx; font-weight: 800; margin-top: 8rpx; }
.record { text-align: right; font-size: 22rpx; color: #718d84; }
.record text { display: block; font-size: 36rpx; color: #183d35; margin-top: 6rpx; }
.score { position: absolute; top: 155rpx; width: 100%; text-align: center; pointer-events: none; z-index: 1; }
.scoreboard { display: flex; margin: 0 36rpx; padding: 22rpx 0; border-radius: 24rpx; background: #ffffffbb; box-shadow: 0 8rpx 30rpx #234b3808; }
.stat { flex: 1; border-right: 1rpx solid #dce8e1; }
.stat:last-child { border-right: none; }
.stat-label { display: block; font-size: 22rpx; color: #718d84; }
.stat-value { display: block; font-size: 46rpx; font-weight: 700; margin-top: 6rpx; }
.reward-stat .stat-value { color: #ad7724; }
.message { font-size: 24rpx; color: #52766a; margin: 18rpx 24rpx 0; }
.reward-help { font-size: 20rpx; color: #8a7958; margin-top: 10rpx; }
.canvas { position: absolute; top: 0; left: 0; z-index: 0; width: 100%; height: 100%; }
.footer { position: absolute; z-index: 2; bottom: calc(32rpx + env(safe-area-inset-bottom)); left: 60rpx; right: 60rpx; text-align: center; }
.meter { height: 10rpx; border-radius: 10rpx; overflow: hidden; background: #d4e2dc; }
.fill { height: 100%; background: #28876d; border-radius: 10rpx; }
.hint { color: #718d84; font-size: 22rpx; margin: 22rpx 0; }
.restart { background: transparent; color: #52766a; font-size: 24rpx; width: 220rpx; }
